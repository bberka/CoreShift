<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CoreShift.App — the WinForms front-end: tray icon, zero-polling hook wiring, dashboard,
    logging pipeline. Published with Native AOT (single native exe).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CoreShift.App</RootNamespace>
    <AssemblyName>CoreShift</AssemblyName>
    <ApplicationIcon>Assets\CoreShift.ico</ApplicationIcon>

    <!-- Native AOT: fast startup, small binary, no JIT -->
    <PublishAot>true</PublishAot>
    <!-- WinForms is AOT-capable on .NET 8+ (see dotnet/winforms NativeAOT samples); the SDK's
         blanket trim guard needs this suppression property to allow AOT publishing. -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>

    <Version>1.0.0</Version>
    <Product>CoreShift</Product>
    <AssemblyTitle>CoreShift</AssemblyTitle>
    <Description>Zero-polling CPU core affinity, process priority and EcoQoS manager for games and background apps.</Description>
    <Company>bberka</Company>
    <Copyright>bberka</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreShift.Core\CoreShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\CoreShift.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.*" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
